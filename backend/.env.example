# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:8443
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
LOG_LEVEL=info

# ─── Base de données PostgreSQL ─────────────────────────────────────────────
# Production / Docker :
DATABASE_URL=postgresql://allotogo:allotogo@localhost:5432/allotogo?schema=public
DIRECT_URL=postgresql://allotogo:allotogo@localhost:5432/allotogo?schema=public
# Développement local avec la base embarquée (`pnpm dev:db`) :
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/allotogo?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5433/allotogo?schema=public
#
# Supabase : DATABASE_URL = URL du pooler Transaction, DIRECT_URL = URL du
# pooler Session (ou connexion directe). Les deux doivent cibler `schema=public`.

# ─── Authentification du personnel ──────────────────────────────────────────
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-64-caracteres
JWT_REFRESH_SECRET=remplacer-par-un-autre-secret-aleatoire-de-64-caracteres
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ─── Compte administrateur de développement ─────────────────────────────────
# Le seed refuse de créer le compte si le mot de passe est absent en production.
SEED_ADMIN_EMAIL=admin@allotogo.test
SEED_ADMIN_PASSWORD=ChangezMoi!2026
SEED_ADMIN_NAME=Administrateur Allo Togo
# Compte informatique initial, créé à chaque seed même si SEED_DEMO_STAFF=false.
# En production, définissez un mot de passe unique et fort avant la première exécution du seed.
SEED_IT_ADMIN_EMAIL=it@allotogo.test
SEED_IT_ADMIN_PASSWORD=ChangezCeMotDePasse!2026
SEED_IT_ADMIN_NAME=Informaticien Allo Togo
SEED_DEMO_STAFF=true

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# simulated | http

# ─── Email (identifiants des comptes créés par l’administration) ─────────────
# simulated : affiche l'email dans les logs du serveur (développement uniquement)
# http      : POST JSON vers un fournisseur compatible (Resend, passerelle interne…)
# smtp      : serveur SMTP avec TLS implicite (Gmail utilise le port 465)
# Pour Gmail, MAIL_PASSWORD doit être un « mot de passe d’application » Google
# (compte Google → Sécurité → Validation en deux étapes → Mots de passe des applications).
EMAIL_PROVIDER=smtp
EMAIL_FROM=Allo Togo Store <no-reply@allotogo.test>
EMAIL_API_URL=
EMAIL_API_TOKEN=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Allo-Togo Shop

# ─── Bictorys (environnement de test) ───────────────────────────────────────
# Ne jamais renseigner de clés réelles dans ce fichier versionné.
BICTORYS_ENABLED=false
BICTORYS_MODE=test
BICTORYS_BASE_URL=
BICTORYS_API_KEY=
BICTORYS_SECRET_KEY=
BICTORYS_WEBHOOK_SECRET=
BICTORYS_SIGNATURE_HEADER=x-bictorys-signature
# Autorise un faux fournisseur local uniquement hors production, pour les tests.
BICTORYS_MOCK=false

# ─── Règles métier ──────────────────────────────────────────────────────────
DELIVERY_FEE_FCFA=0
DELIVERY_CAN_RECORD_PAYMENT=false
TRACKING_ACCESS_TTL_HOURS=24
TRACKING_LOOKUP_MAX_ATTEMPTS=10
