{
  "name": "allo-togo-store-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API Allo Togo Store — commandes, catalogue, paiements, messagerie et back-office",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap-admin": "tsx prisma/seed.ts --accounts-only",
    "db:studio": "prisma studio",
    "dev:db": "tsx scripts/dev-db.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Pas de linter configuré — exécuter pnpm typecheck\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "^10.2.1",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.10.0-beta.17",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
