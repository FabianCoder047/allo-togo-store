# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Seules les variables préfixées VITE_ sont exposées au navigateur.
# Ne jamais y placer de secret.

# Cible du proxy de développement pour /api et /socket.io.
# Par défaut : http://localhost:4000
VITE_API_PROXY_TARGET=http://localhost:4000

# Base de l'API côté navigateur.
# Laisser vide en production si le frontend et l'API partagent la même origine
# (le client utilise alors /api).
# VITE_API_URL=https://api.exemple.tg/api

# ─── PostHog (mesure d’audience, facultatif) ────────────────────────────────
# L’intégration reste totalement inactive si VITE_POSTHOG_KEY est vide.
# La clé est publique (projet PostHog), ne mettez jamais de secret ici.
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
# VITE_POSTHOG_DASHBOARD_URL=https://eu.posthog.com/project/…

# ─── Backend ────────────────────────────────────────────────────────────────
# La configuration complète de l'API se trouve dans backend/.env.example
# (base de données, secrets JWT, WhatsApp, SMTP, Bictorys, règles métier).
# Pour `docker compose`, les variables ci-dessous sont lues depuis le `.env`
# racine. En local, configurez plutôt `backend/.env`.
DATABASE_URL=postgresql://allotogo:allotogo@db:5432/allotogo?schema=public
DIRECT_URL=postgresql://allotogo:allotogo@db:5432/allotogo?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ─── Email SMTP ─────────────────────────────────────────────────────────────
# Gmail : utiliser un mot de passe d'application, jamais le mot de passe du compte.
EMAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Allo-Togo Shop
